{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grabby",
  "version": "0.3.0",
  "identifier": "com.whicencer.ytdownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grabby",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/deno"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/yt-dlp/": "helpers/yt-dlp/"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RDAxMTkxNjEyMjE4NEMKUldSTUdDSmhrUkhRT0QydDFJN3o4a09YMU96MXZoamJubW9wd0EwSEJNRWIzazZJK1ErU0oxU00K",
      "endpoints": [
        "https://github.com/whicencer/grabby/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
